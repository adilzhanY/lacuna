  "items": [
    {
      "n": 1,
      "segments": [
        {"type": "text", "text": "Der Zug fiel infolge"},
        {"type": "blank", "id": "1a", "accept": ["eines"], "tags": ["trigger:genitive_preposition", "case:genitive", "declension:indefinite_article"]},
        {"type": "text", "text": "Stromausfalls aus."}
      ],
      "hint": "Stromausfall, m"
    },
    {
      "n": 2,
      "segments": [
        {"type": "text", "text": "Er bedarf dringend"},
        {"type": "blank", "id": "2a", "accept": ["absoluter"], "tags": ["trigger:verb_genitive", "case:genitive", "declension:strong"]},
        {"type": "text", "text": "Ruhe."}
      ],
      "hint": "absolut"
    },
    {
      "n": 3,
      "segments": [
        {"type": "text", "text": "Die Nachbarin sagte, sie"},
        {"type": "blank", "id": "3a", "accept": ["habe"], "tags": ["form:konjunktiv_1", "trigger:indirect_speech"]},
        {"type": "text", "text": "morgen keine Zeit."}
      ],
      "hint": "haben"
    },
    {
      "n": 4,
      "segments": [
        {"type": "text", "text": "Die Bahn teilte mit, der Zug"},
        {"type": "blank", "id": "4a", "accept": ["werde"], "tags": ["form:konjunktiv_1", "trigger:indirect_speech"]},
        {"type": "text", "text": "mit zehn Minuten Verspätung eintreffen."}
