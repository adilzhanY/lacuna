    {
      "n": 14,
      "segments": [
        {"type": "text", "text": "Ich"},
        {"type": "blank", "id": "14a", "accept": ["fände"], "tags": ["form:konjunktiv_ii", "trigger:wenn_clause"]},
        {"type": "text", "text": "es schön, wenn wir uns öfter sehen."}
      ],
      "hint": "finden"
    },
    {
      "n": 15,
      "segments": [
        {"type": "text", "text": "Ich"},
        {"type": "blank", "id": "15a", "accept": ["bliebe"], "tags": ["form:konjunktiv_ii"]},
        {"type": "text", "text": "gern noch länger, aber ich muss los."}
