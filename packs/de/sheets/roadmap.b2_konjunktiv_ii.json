      "segments": [
        {"type": "blank", "id": "16a", "accept": ["Könnten"], "tags": ["form:konjunktiv_ii", "word_order:verb_first", "trigger:polite_request"]},
        {"type": "text", "text": "Sie mir bitte helfen?"}
