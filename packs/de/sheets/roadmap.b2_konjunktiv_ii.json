      "hint": "können"
    },
    {
      "n": 8,
      "segments": [
        {"type": "text", "text": "Du"},
        {"type": "blank", "id": "8a", "accept": ["solltest"], "tags": ["form:konjunktiv_ii", "form:modal", "trigger:advice"]},
        {"type": "text", "text": "dich bei ihr entschuldigen."}
      ],
      "hint": "sollen"
    },
    {
      "n": 9,
      "segments": [
        {"type": "text", "text": "Er"},
        {"type": "blank", "id": "9a", "accept": ["müsste"], "tags": ["form:konjunktiv_ii", "form:modal"]},
        {"type": "text", "text": "eigentlich schon lange zum Arzt gehen."}
      ],
      "hint": "müssen"
    },
    {
      "n": 10,
      "segments": [
        {"type": "text", "text": "Ich wünschte, es"},
        {"type": "blank", "id": "10a", "accept": ["gäbe"], "tags": ["form:konjunktiv_ii", "trigger:wish"]},
        {"type": "text", "text": "hier mehr Parkplätze."}
      ],
      "hint": "geben"
    },
    {
      "n": 11,
      "segments": [
        {"type": "text", "text": "Sie spricht Deutsch, als"},
        {"type": "blank", "id": "11a", "accept": ["wäre"], "tags": ["form:konjunktiv_ii", "trigger:als_ob"]},
        {"type": "text", "text": "sie hier geboren."}
      ],
      "hint": "sein"
    },
    {
      "n": 12,
      "segments": [
        {"type": "text", "text": "Ich"},
        {"type": "blank", "id": "12a", "accept": ["hätte"], "tags": ["form:konjunktiv_ii", "form:plusquamperfekt"]},
        {"type": "text", "text": "das früher gewusst."}
