    {
      "n": 20,
      "segments": [
        {"type": "text", "text": "Wenn du gestern angerufen hättest,"},
        {"type": "blank", "id": "20a", "accept": ["wären"], "tags": ["form:konjunktiv_ii", "form:plusquamperfekt", "trigger:wenn_clause"]},
        {"type": "text", "text": "wir zusammen ins Kino gegangen."}
      ],
      "hint": "sein"
    }
