      "hint": "werden"
    },
    {
      "n": 19,
      "segments": [
        {"type": "text", "text": "Die Kinder"},
        {"type": "blank", "id": "19a", "accept": ["kämen"], "tags": ["form:konjunktiv_ii"]},
        {"type": "text", "text": "gern am Samstag mit uns zum Schwimmen."}
