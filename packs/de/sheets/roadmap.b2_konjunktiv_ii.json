      "hint": "sein"
    },
    {
      "n": 18,
      "segments": [
        {"type": "text", "text": "Meine Eltern"},
        {"type": "blank", "id": "18a", "accept": ["würden"], "tags": ["form:konjunktiv_ii", "form:wuerde_periphrase"]},
        {"type": "text", "text": "gern einmal nach Japan reisen."}
