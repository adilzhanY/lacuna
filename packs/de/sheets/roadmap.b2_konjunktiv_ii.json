        {"type": "text", "text": "wir heute an den See."}
      ],
      "hint": "gehen"
    },
    {
      "n": 6,
      "segments": [
        {"type": "blank", "id": "6a", "accept": ["Hätten"], "tags": ["form:konjunktiv_ii", "word_order:verb_first"]},
        {"type": "text", "text": "wir mehr Geld, würden wir ein Haus kaufen."}
      ],
      "hint": "haben"
    },
    {
      "n": 7,
      "segments": [
        {"type": "text", "text": "Ich"},
        {"type": "blank", "id": "7a", "accept": ["könnte"], "tags": ["form:konjunktiv_ii", "form:modal"]},
        {"type": "text", "text": "dir helfen, aber ich habe keine Zeit."}
