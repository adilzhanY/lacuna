      "hint": "sich freuen auf"
    },
    {
      "n": 2,
      "segments": [
        {"type": "blank", "id": "2a", "accept": ["Worüber"], "tags": ["form:interrogative_adverb", "trigger:preposition_uber"]},
        {"type": "text", "text": "hast du dich so geärgert?"}
      ],
      "hint": "sich ärgern über"
    },
    {
      "n": 3,
      "segments": [
        {"type": "text", "text": "Sag mir,"},
        {"type": "blank", "id": "3a", "accept": ["wofür"], "tags": ["form:interrogative_adverb", "trigger:preposition_fuer"]},
        {"type": "text", "text": "du dich so interessierst."}
      ],
      "hint": "sich interessieren für"
    },
    {
      "n": 4,
      "segments": [
        {"type": "text", "text": "Ich warte seit einer Stunde"},
        {"type": "blank", "id": "4a", "accept": ["darauf"], "tags": ["form:pronominal_adverb", "trigger:preposition_auf"]},
        {"type": "text", "text": ", dass der Handwerker endlich kommt."}
