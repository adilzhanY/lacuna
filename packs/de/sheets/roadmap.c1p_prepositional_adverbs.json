  "items": [
    {
      "n": 1,
      "segments": [
        {"type": "text", "text": "Ich freue mich schon sehr"},
        {"type": "blank", "id": "1a", "accept": ["darauf"], "tags": ["form:pronominal_adverb", "trigger:preposition_auf"]},
        {"type": "text", "text": ", dass du endlich kommst."}
