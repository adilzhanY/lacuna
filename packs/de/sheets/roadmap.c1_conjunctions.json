    {
      "n": 15,
      "segments": [
        {"type": "blank", "id": "15a", "accept": ["Sobald"], "tags": ["trigger:temporal", "word_order:verb_final"]},
        {"type": "text", "text": "der Bus kommt, steigen wir ein."}
