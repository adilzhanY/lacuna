  "items": [
    {
      "n": 1,
      "segments": [
        {"type": "text", "text": "Wir gehen heute spazieren,"},
        {"type": "blank", "id": "1a", "accept": ["obwohl"], "tags": ["trigger:concessive", "word_order:verb_final"]},
        {"type": "text", "text": "es draußen kalt ist."}
