      "hint": "Reihenfolge"
    },
    {
      "n": 13,
      "segments": [
        {"type": "text", "text": "Ich schreibe die Liste,"},
        {"type": "blank", "id": "13a", "accept": ["bevor"], "tags": ["trigger:bevor"]},
