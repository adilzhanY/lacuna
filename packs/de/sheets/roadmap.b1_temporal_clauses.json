  "items": [
    {
      "n": 1,
      "segments": [
        {"type": "blank", "id": "1a", "accept": ["Als"], "tags": ["trigger:als", "capitalisation:sentence_start"]},
        {"type": "text", "text": "ich letzte Woche beim Bäcker war, traf ich meine alte Nachbarin."}
      ],
      "hint": "Vergangenheit, einmal"
    },
    {
      "n": 2,
      "segments": [
        {"type": "text", "text": "Der Zug fuhr ab,"},
